import qs.modules.ii.bar.weather
import qs.modules.ii.sidebarRight.quickToggles.classicStyle
import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Services.UPower
import qs
import qs.services
import qs.modules.common
import qs.modules.common.widgets
import qs.modules.common.functions

Item { // Bar content region
    id: root

    property var screen: root.QsWindow.window?.screen
    property var brightnessMonitor: Brightness.getMonitorForScreen(screen)
    property real useShortenedForm: (Appearance.sizes.barHellaShortenScreenWidthThreshold >= screen?.width) ? 2 : (Appearance.sizes.barShortenScreenWidthThreshold >= screen?.width) ? 1 : 0
    readonly property int centerSideModuleWidth: (useShortenedForm == 2) ? Appearance.sizes.barCenterSideModuleWidthHellaShortened : (useShortenedForm == 1) ? Appearance.sizes.barCenterSideModuleWidthShortened : Appearance.sizes.barCenterSideModuleWidth

    component VerticalBarSeparator: Rectangle {
        Layout.topMargin: Appearance.sizes.baseBarHeight / 3
        Layout.bottomMargin: Appearance.sizes.baseBarHeight / 3
        Layout.fillHeight: true
        implicitWidth: 1
        color: Appearance.colors.colOutlineVariant
    }

    // Background shadow
    Loader {
        active: Config.options.bar.showBackground && Config.options.bar.cornerStyle === 1 && Config.options.bar.floatStyleShadow
        anchors.fill: barBackground
        sourceComponent: StyledRectangularShadow {
            anchors.fill: undefined // The loader's anchors act on this, and this should not have any anchor
            target: barBackground
        }
    }
    // Background
    Rectangle {
        id: barBackground
        anchors {
            fill: parent
            margins: Config.options.bar.cornerStyle === 1 ? (Appearance.sizes.hyprlandGapsOut) : 0 // idk why but +1 is needed
        }
        // The bar surface stays transparent; BarGroup draws the individual pills.
        color: "transparent"
        radius: 0
        border.width: 0
    }

    FocusedScrollMouseArea { // Left side | scroll to change brightness
        id: barLeftSideMouseArea

        anchors {
            top: parent.top
            bottom: parent.bottom
            left: parent.left
            right: middleSection.left
        }
        implicitWidth: leftSectionRowLayout.implicitWidth
        implicitHeight: Appearance.sizes.baseBarHeight

        onScrollDown: Brightness.decreaseBrightness()
        onScrollUp: Brightness.increaseBrightness()
        onMovedAway: GlobalStates.osdBrightnessOpen = false
        // Visual content
        ScrollHint {
            reveal: barLeftSideMouseArea.hovered
            icon: Hyprsunset.gamma === 100 ? "light_mode" : "wb_twilight"
            tooltipText: Translation.tr("Scroll to change brightness")
            side: "left"
            anchors.left: parent.left
            anchors.verticalCenter: parent.verticalCenter
        }

        RowLayout {
            id: leftSectionRowLayout
            anchors.fill: parent
            spacing: 4

            BarGroup { // Arch system-information launcher
                Layout.alignment: Qt.AlignVCenter
                Layout.leftMargin: Appearance.rounding.screenRounding
                padding: 4

                GroupButton {
                    id: archInfoButton
                    baseWidth: 68
                    baseHeight: 28
                    clickedWidth: 72
                    clickedHeight: 30
                    buttonRadius: Appearance.rounding.full
                    buttonRadiusPressed: Appearance.rounding.full
                    colBackground: "transparent"
                    colBackgroundHover: Qt.rgba(1, 1, 1, 0.08)
                    colBackgroundActive: Qt.rgba(1, 1, 1, 0.12)
                    onClicked: Quickshell.execDetached(["kitty", "-1", "--hold=yes", "fish", "-i", "-c", "if type -q fastfetch; fastfetch; else; echo 'Fastfetch is not installed.'; echo 'Install it with: sudo pacman -S fastfetch'; end"])

                    contentItem: Row {
                        anchors.centerIn: parent
                        spacing: 5

                        MaterialSymbol {
                            anchors.verticalCenter: parent.verticalCenter
                            text: "terminal"
                            iconSize: 18
                            color: Appearance.colors.colOnLayer1
                        }

                        Text {
                            anchors.verticalCenter: parent.verticalCenter
                            text: "Arch"
                            color: Appearance.colors.colOnLayer1
                            font.pixelSize: 13
                            font.weight: Font.DemiBold
                        }
                    }

                    StyledToolTip {
                        text: "Open system information in Kitty"
                    }
                }
            }

            BarGroup {
                id: workspaceGroup
                Layout.alignment: Qt.AlignVCenter
                padding: 4

                Workspaces {
                    id: workspacesWidget
                    Layout.fillHeight: true
                    MouseArea {
                        // Right-click to toggle overview
                        anchors.fill: parent
                        acceptedButtons: Qt.RightButton
                        onPressed: event => {
                            if (event.button === Qt.RightButton)
                                GlobalStates.overviewOpen = !GlobalStates.overviewOpen;
                        }
                    }
                }
            }

        }
    }

    Row { // Middle section
        id: middleSection
        anchors {
            top: parent.top
            bottom: parent.bottom
            horizontalCenter: parent.horizontalCenter
        }
        spacing: 4

        BarGroup {
            id: clockGroup
            anchors.verticalCenter: parent.verticalCenter
            padding: 6

            ClockWidget {
                showDate: true
                Layout.alignment: Qt.AlignVCenter
            }
        }
    }

    FocusedScrollMouseArea { // Right side | scroll to change volume
        id: barRightSideMouseArea

        anchors {
            top: parent.top
            bottom: parent.bottom
            left: middleSection.right
            right: parent.right
        }
        implicitWidth: rightSectionRowLayout.implicitWidth
        implicitHeight: Appearance.sizes.baseBarHeight

        onScrollDown: Audio.decrementVolume();
        onScrollUp: Audio.incrementVolume();
        onMovedAway: GlobalStates.osdVolumeOpen = false;
        // Visual content
        ScrollHint {
            reveal: barRightSideMouseArea.hovered
            icon: "volume_up"
            tooltipText: Translation.tr("Scroll to change volume")
            side: "right"
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
        }

        RowLayout {
            id: rightSectionRowLayout
            anchors.fill: parent
            spacing: 5
            layoutDirection: Qt.RightToLeft

            BarGroup { // Dedicated settings/control-center pill
                Layout.alignment: Qt.AlignRight | Qt.AlignVCenter
                Layout.rightMargin: Appearance.rounding.screenRounding
                padding: 4

                RippleButton {
                    id: settingsPillButton
                    implicitWidth: 42
                    implicitHeight: 28
                    buttonRadius: Appearance.rounding.full
                    colBackground: "transparent"
                    colBackgroundHover: Appearance.colors.colLayer1Hover
                    onClicked: GlobalStates.sidebarRightOpen = !GlobalStates.sidebarRightOpen

                    contentItem: MaterialSymbol {
                        anchors.centerIn: parent
                        text: "tune"
                        iconSize: Appearance.font.pixelSize.large
                        color: GlobalStates.sidebarRightOpen ? Appearance.colors.colPrimary : Appearance.colors.colOnLayer1
                    }

                    StyledToolTip {
                        text: Translation.tr("Open quick settings")
                    }
                }
            }

            BarGroup {
                visible: BluetoothStatus.available
                Layout.alignment: Qt.AlignVCenter
                padding: 4

                BluetoothToggle {
                    baseWidth: 42
                    baseHeight: 28
                    clickedWidth: 46
                    clickedHeight: 30
                    buttonRadius: Appearance.rounding.full
                    buttonRadiusPressed: Appearance.rounding.full
                    colBackground: "transparent"
                    colBackgroundHover: Qt.rgba(1, 1, 1, 0.06)
                    colBackgroundToggled: Qt.rgba(1, 1, 1, 0.08)
                    colBackgroundToggledHover: Qt.rgba(1, 1, 1, 0.13)
                    colBackgroundToggledActive: Qt.rgba(1, 1, 1, 0.18)
                    altAction: () => GlobalStates.sidebarRightOpen = true
                    contentItem: MaterialSymbol {
                        anchors.centerIn: parent
                        iconSize: 22
                        fill: parent.toggled ? 1 : 0
                        color: Appearance.colors.colOnLayer1
                        text: parent.buttonIcon
                    }
                }
            }

            BarGroup {
                Layout.alignment: Qt.AlignVCenter
                padding: 4

                NetworkToggle {
                    baseWidth: 42
                    baseHeight: 28
                    clickedWidth: 46
                    clickedHeight: 30
                    buttonRadius: Appearance.rounding.full
                    buttonRadiusPressed: Appearance.rounding.full
                    colBackground: "transparent"
                    colBackgroundHover: Qt.rgba(1, 1, 1, 0.06)
                    colBackgroundToggled: Qt.rgba(1, 1, 1, 0.08)
                    colBackgroundToggledHover: Qt.rgba(1, 1, 1, 0.13)
                    colBackgroundToggledActive: Qt.rgba(1, 1, 1, 0.18)
                    altAction: () => GlobalStates.sidebarRightOpen = true
                    contentItem: MaterialSymbol {
                        anchors.centerIn: parent
                        iconSize: 22
                        fill: parent.toggled ? 1 : 0
                        color: Appearance.colors.colOnLayer1
                        text: parent.buttonIcon
                    }
                }
            }

            BarGroup { // Power profile is its own clickable pill
                Layout.alignment: Qt.AlignVCenter
                padding: 4

                UtilButtons {
                    Layout.alignment: Qt.AlignVCenter
                }
            }

            BarGroup {
                visible: Battery.available
                Layout.alignment: Qt.AlignVCenter
                padding: 6

                BatteryIndicator {
                    Layout.alignment: Qt.AlignVCenter
                }
            }

            BarGroup {
                visible: root.useShortenedForm === 0
                Layout.alignment: Qt.AlignVCenter
                padding: 5

                SysTray {
                    Layout.fillHeight: true
                    invertSide: Config?.options.bar.bottom
                }
            }

            Item {
                Layout.fillWidth: true
                Layout.fillHeight: true
            }

            // Weather
            Loader {
                Layout.leftMargin: 4
                active: Config.options.bar.weather.enable

                sourceComponent: BarGroup {
                    WeatherBar {}
                }
            }
        }
    }
}

@import "rofi-colors.rasi"

configuration {
    show-icons: true;
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    font: "Google Sans Flex 11";
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color: @on-surface;
}

window {
    width: 900px;
    height: 500px;
    padding: 20px;
    border: 1px;
    border-radius: 24px;
    border-color: @outline;
    background-color: @surface;
}

mainbox {
    spacing: 12px;
    children: [ "inputbar", "listview", "textbox-help" ];
}

inputbar {
    padding: 10px 16px;
    border: 1px;
    border-radius: 14px;
    border-color: @outline;
    background-color: @surface-container;
    spacing: 12px;
    children: [ "prompt", "entry", "num-filtered-rows" ];
}

prompt {
    text-color: @primary;
    font: "Google Sans Flex Bold 12";
}

entry {
    text-color: @on-surface;
    placeholder: "Search theme packs...";
    placeholder-color: @outline;
}

num-filtered-rows {
    text-color: @outline;
    expand: false;
    vertical-align: 0.5;
}

listview {
    columns: 3;
    lines: 2;
    cycle: true;
    dynamic: true;
    layout: vertical;
    fixed-columns: true;
    fixed-height: false;
    spacing: 12px;
    background-color: transparent;
}

element {
    orientation: vertical;
    children: [ "element-icon", "element-text" ];
    spacing: 8px;
    padding: 10px 8px 8px 8px;
    border: 1px;
    border-radius: 16px;
    border-color: transparent;
    background-color: @surface-container;
    cursor: pointer;
}

element selected {
    border: 2px;
    border-color: @primary;
    background-color: @primary-container;
    text-color: @on-primary-container;
}

element-icon {
    size: 105px;
    border-radius: 10px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    text-color: inherit;
    font: "Google Sans Flex Medium 10.5";
}

textbox-help {
    expand: false;
    str: "󰌑 Apply Theme  •  󰁔 Navigate  •   Filter  •  󱊷 Cancel";
    horizontal-align: 0.5;
    text-color: @outline;
    font: "Google Sans Flex 10";
    padding: 4px 0 0 0;
}

@import "rofi-colors.rasi"

configuration {
    show-icons: false;
    matching: "fuzzy";
    sort: false;
    font: "Google Sans Flex 11";
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color: @on-surface;
}

window {
    width: 840px;
    height: 500px;
    padding: 24px;
    border: 1.5px;
    border-radius: 26px;
    border-color: @primary-glow;
    background-color: @surface;
}

mainbox {
    spacing: 14px;
    children: [ "inputbar", "listview", "textbox-help" ];
}

inputbar {
    padding: 12px 18px;
    border: 1px;
    border-radius: 18px;
    border-color: @outline;
    background-color: @surface-container;
    spacing: 12px;
    children: [ "prompt", "entry" ];
}

prompt {
    text-color: @primary;
    font: "Google Sans Flex Bold 12";
}

entry {
    text-color: @on-surface;
    placeholder: "Click or select audio device to activate...";
    placeholder-color: @on-surface-variant;
}

listview {
    columns: 2;
    lines: 4;
    cycle: true;
    dynamic: true;
    layout: vertical;
    fixed-columns: true;
    fixed-height: false;
    spacing: 12px;
    background-color: transparent;
}

element {
    orientation: vertical;
    children: [ "element-text" ];
    spacing: 6px;
    padding: 14px 18px;
    border: 1px;
    border-radius: 18px;
    border-color: @outline;
    background-color: @surface-container;
    cursor: pointer;
}

element selected {
    border: 1.5px;
    border-color: @outline-focus;
    background-color: @primary-container;
    text-color: @on-primary-container;
}

element-text {
    horizontal-align: 0.0;
    vertical-align: 0.5;
    text-color: inherit;
    markup: true;
    font: "Google Sans Flex 11";
}

textbox-help {
    expand: false;
    str: "󰌑 Click or Press Enter to Switch Device  •  󰁔 Navigate  •  󱊷 Esc to Exit";
    horizontal-align: 0.5;
    text-color: @on-surface-variant;
    font: "Google Sans Flex 10";
    padding: 6px 0 0 0;
}

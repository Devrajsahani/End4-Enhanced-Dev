#!/usr/bin/env bash
# ii-refresh-rate - Seamlessly toggle display refresh rate (60Hz <-> 144Hz)
# Integrates with Hyprland and QuickShell centered OSD pill.

set -euo pipefail

DISPLAY_NAME="eDP-1"
REFRESH_FILE="$HOME/.config/hypr/refresh-rate"

# Determine current refresh rate
get_current_rate() {
    local rate
    rate=$(hyprctl -j monitors 2>/dev/null | jq -r --arg d "$DISPLAY_NAME" '(.[] | select(.name == $d) | .refreshRate // 144) | round' 2>/dev/null || echo "144")
    echo "$rate"
}

CURRENT_RATE=$(get_current_rate)

# Determine target rate
TARGET_RATE=""
case "${1:-toggle}" in
    60|60Hz|60hz)
        TARGET_RATE=60
        ;;
    144|144Hz|144hz)
        TARGET_RATE=144
        ;;
    toggle)
        if (( CURRENT_RATE >= 100 )); then
            TARGET_RATE=60
        else
            TARGET_RATE=144
        fi
        ;;
    status)
        echo "${CURRENT_RATE} Hz"
        exit 0
        ;;
    *)
        echo "Usage: $(basename "$0") [60|144|toggle|status]"
        exit 1
        ;;
esac

# Get current display position and scale
MONITOR_JSON=$(hyprctl -j monitors 2>/dev/null | jq -c --arg d "$DISPLAY_NAME" '.[] | select(.name == $d)' 2>/dev/null || echo "{}")
POS_X=$(echo "$MONITOR_JSON" | jq -r '.x // 0')
POS_Y=$(echo "$MONITOR_JSON" | jq -r '.y // 0')
SCALE=$(echo "$MONITOR_JSON" | jq -r '.scale // 1')
POS="${POS_X}x${POS_Y}"

# Persist target rate
mkdir -p "$(dirname "$REFRESH_FILE")"
echo "$TARGET_RATE" > "$REFRESH_FILE"

# Apply refresh rate in Hyprland
hyprctl repl "hl.monitor({ output = '${DISPLAY_NAME}', mode = '1920x1080@${TARGET_RATE}.0', position = '${POS}', scale = ${SCALE} })" >/dev/null 2>&1 || true

# Trigger QuickShell OSD (Header pill with speed icon and current rate)
qs -c ii ipc call osd showRefreshRate "${TARGET_RATE} Hz" >/dev/null 2>&1 || true

echo "Switched refresh rate to ${TARGET_RATE} Hz"

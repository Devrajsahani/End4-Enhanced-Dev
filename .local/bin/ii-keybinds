#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys

ROFI_THEME = os.path.expanduser("~/.config/illogical-impulse/theme-packs/keybinds.rasi")
MOD_ORDER = [(64, "SUPER"), (4, "CTRL"), (8, "ALT"), (1, "SHIFT")]

def decode_modmask(mask):
    mods = []
    for val, name in MOD_ORDER:
        if mask & val:
            mods.append(name)
    return " + ".join(mods)

def get_binds():
    records = []
    seen = set()

    # 1. Read custom keybinds
    custom_path = os.path.expanduser("~/.config/hypr/custom/keybinds.lua")
    if os.path.isfile(custom_path):
        with open(custom_path) as f:
            for line in f:
                m = re.search(r'hl\.bind\(\s*["\']([^"\']+)["\']\s*,\s*hl\.dsp\.exec_cmd\(\s*([^,)]+)\s*\)\s*(?:,\s*\{\s*description\s*=\s*["\']([^"\']+)["\'])?', line)
                if m:
                    key = m.group(1).strip()
                    desc = m.group(3) or "Custom shortcut"
                    combo = key.strip()
                    if combo not in seen:
                        seen.add(combo)
                        cmd = m.group(2).strip().strip('"').strip("'")
                        cmd = cmd.replace("HOME .. \"", os.path.expanduser("~")).replace("\"", "")
                        records.append((combo, desc, "exec", cmd))

    # 2. Read from hyprctl binds
    try:
        out = subprocess.check_output(["hyprctl", "-j", "binds"]).decode()
        binds = json.loads(out)
        for b in binds:
            desc = b.get("description", "").strip()
            key = b.get("key", "").strip()
            if not key or key in ["SUPER_L", "SUPER_R"]:
                continue
            mod = decode_modmask(b.get("modmask", 0))
            combo = f"{mod} + {key}" if mod else key
            disp = b.get("dispatcher", "")
            arg = b.get("arg", "")
            
            if not desc:
                if disp == "killactive":
                    desc = "Window: Close active window"
                elif disp == "togglefloating":
                    desc = "Window: Toggle floating mode"
                elif disp == "fullscreen":
                    desc = "Window: Toggle fullscreen"
                elif disp.startswith("movefocus"):
                    desc = f"Window: Focus {arg}"
                elif disp.startswith("movewindow"):
                    desc = f"Window: Move {arg}"
                elif disp == "workspace":
                    desc = f"Workspace: Switch to {arg}"
                elif disp == "movetoworkspace":
                    desc = f"Workspace: Move window to {arg}"
                elif disp == "exec":
                    desc = f"Execute: {arg}"
                else:
                    continue

            if combo not in seen:
                seen.add(combo)
                records.append((combo, desc, disp, arg))
    except Exception:
        pass

    return records

def main():
    records = get_binds()
    if not records:
        sys.exit(0)

    # Format into Pango markup lines for Rofi
    lines = []
    for combo, desc, _, _ in records:
        cat = "General"
        text = desc
        if ":" in desc:
            parts = desc.split(":", 1)
            cat = parts[0].strip()
            text = parts[1].strip()
        
        # Pango formatted line with bold shortcut badge and category tag
        line = f"<b>{combo:24}</b>  <span alpha='65%'>│</span>  <span weight='bold' alpha='85%'>[{cat}]</span> {text}"
        lines.append(line)

    menu_input = "\n".join(lines)
    cmd = [
        "rofi",
        "-dmenu",
        "-i",
        "-no-custom",
        "-markup-rows",
        "-p", "󰌌 Keybindings",
        "-theme", ROFI_THEME,
        "-format", "i"
    ]

    try:
        proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        stdout, _ = proc.communicate(input=menu_input)
        if proc.returncode != 0 or not stdout.strip():
            sys.exit(0)

        idx = int(stdout.strip())
        if 0 <= idx < len(records):
            _, _, disp, arg = records[idx]
            if disp == "exec":
                subprocess.Popen(arg, shell=True)
            elif disp:
                cmd_dispatch = ["hyprctl", "dispatch", disp]
                if arg:
                    cmd_dispatch.append(arg)
                subprocess.Popen(cmd_dispatch)
    except Exception:
        sys.exit(0)

if __name__ == "__main__":
    main()


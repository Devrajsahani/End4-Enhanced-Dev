#!/usr/bin/env python3
import os
import re
import subprocess
import sys

ROFI_THEME = os.path.expanduser("~/.config/illogical-impulse/theme-packs/audio.rasi")

def get_devices():
    try:
        out = subprocess.check_output(["wpctl", "status"], stderr=subprocess.DEVNULL).decode()
    except Exception:
        return []

    lines = out.splitlines()
    section = None
    devices = []

    for line in lines:
        if "Sinks:" in line:
            section = "sink"
            continue
        elif "Sources:" in line:
            section = "source"
            continue
        elif "Filters:" in line or "Streams:" in line or "Video" in line:
            section = None
            continue

        if section in ("sink", "source"):
            # Match line like: │  *   54. Ryzen HD Audio Controller Analog Stereo [vol: 0.52]
            # or:              │      65. AD107 High Definition Audio Controller Digital Stereo (HDMI) [vol: 0.40]
            m = re.search(r'([*]?)\s*(\d+)\.\s+(.*?)(?:\s+\[vol:\s*([0-9.]+)(\s*MUTED)?\])?$', line)
            if m:
                is_active = bool(m.group(1))
                dev_id = m.group(2)
                name = m.group(3).strip()
                vol = m.group(4)
                muted = bool(m.group(5))
                
                vol_str = ""
                if vol:
                    vol_pct = int(float(vol) * 100)
                    vol_str = f"({vol_pct}%{' MUTED' if muted else ''})"

                icon = "󰓃"
                if "HDMI" in name or "Digital" in name:
                    icon = "󰍹"
                elif "Headphone" in name or "Headset" in name:
                    icon = "󰋋"
                elif section == "source":
                    icon = "󰍬"

                devices.append({
                    "id": dev_id,
                    "name": name,
                    "section": section.capitalize(),
                    "active": is_active,
                    "vol": vol_str,
                    "icon": icon
                })

    return devices

def main():
    devices = get_devices()
    if not devices:
        sys.exit(0)

    menu_lines = []
    sel_row = 0
    for i, dev in enumerate(devices):
        check = "✔ " if dev["active"] else "   "
        if dev["active"] and sel_row == 0:
            sel_row = i
        
        line = f"{check}{dev['icon']}  <b>{dev['name']}</b>  <span alpha='65%'>[{dev['section']}]</span>  <span alpha='80%'>{dev['vol']}</span>"
        menu_lines.append(line)

    menu_input = "\n".join(menu_lines)
    cmd = [
        "rofi",
        "-dmenu",
        "-i",
        "-no-custom",
        "-markup-rows",
        "-p", "󰓃 Audio",
        "-theme", ROFI_THEME,
        "-selected-row", str(sel_row),
        "-format", "i"
    ]

    try:
        proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
        stdout, _ = proc.communicate(input=menu_input)
        if proc.returncode != 0 or not stdout.strip():
            sys.exit(0)

        idx = int(stdout.strip())
        if 0 <= idx < len(devices):
            selected = devices[idx]
            subprocess.run(["wpctl", "set-default", selected["id"]], check=True)
            subprocess.run([
                "notify-send",
                "-a", "Audio Switcher",
                "Default Audio Changed",
                f"{selected['icon']} {selected['name']} is now the active {selected['section'].lower()}."
            ])
    except Exception:
        sys.exit(0)

if __name__ == "__main__":
    main()


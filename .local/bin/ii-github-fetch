#!/usr/bin/env python3
"""
ii-github-fetch: Collects local git commits and remote GitHub activity for developer widget.
Outputs JSON for Quickshell consumption.
"""
import sys
import json
import subprocess
import urllib.request
import os

CACHE_DIR = os.path.expanduser("~/.local/state/quickshell/user/generated")
CACHE_FILE = os.path.join(CACHE_DIR, "github_activity.json")
DEFAULT_REPO = os.path.expanduser("~/End4-Enhanced-Dev")

def get_local_git_info(repo_dir=DEFAULT_REPO):
    if not os.path.isdir(os.path.join(repo_dir, ".git")):
        return None
    try:
        # Branch
        branch = subprocess.check_output(
            ["git", "-C", repo_dir, "rev-parse", "--abbrev-ref", "HEAD"],
            stderr=subprocess.DEVNULL, text=True
        ).strip()
        
        # Status (clean/dirty)
        status_raw = subprocess.check_output(
            ["git", "-C", repo_dir, "status", "--porcelain"],
            stderr=subprocess.DEVNULL, text=True
        ).strip()
        is_clean = len(status_raw) == 0

        # Commits
        log_raw = subprocess.check_output(
            ["git", "-C", repo_dir, "log", "-n", "8", "--format=%h|%an|%cr|%s"],
            stderr=subprocess.DEVNULL, text=True
        ).strip()
        
        commits = []
        for line in log_raw.splitlines():
            parts = line.split("|", 3)
            if len(parts) == 4:
                commits.append({
                    "hash": parts[0],
                    "author": parts[1],
                    "time": parts[2],
                    "message": parts[3]
                })

        repo_name = os.path.basename(repo_dir.rstrip("/"))
        return {
            "name": repo_name,
            "path": repo_dir,
            "branch": branch,
            "clean": is_clean,
            "commits": commits
        }
    except Exception:
        return None

def get_remote_github_events(username="Devrajsahani"):
    if not username:
        return []
    url = f"https://api.github.com/users/{username}/events/public"
    try:
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "Mozilla/5.0 (X11; Linux x86_64)", "Accept": "application/vnd.github.v3+json"}
        )
        with urllib.request.urlopen(req, timeout=4) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            events = []
            for ev in data[:10]:
                ev_type = ev.get("type", "")
                repo_name = ev.get("repo", {}).get("name", "")
                created_at = ev.get("created_at", "")
                payload = ev.get("payload", {})
                commits = payload.get("commits", [])
                msg = commits[0].get("message", "") if commits else ""
                events.append({
                    "type": ev_type,
                    "repo": repo_name,
                    "created": created_at,
                    "message": msg
                })
            return events
    except Exception:
        return []

def main():
    username = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] else "Devrajsahani"
    repo_dir = sys.argv[2] if len(sys.argv) > 2 and sys.argv[2] else DEFAULT_REPO

    local_info = get_local_git_info(repo_dir)
    remote_events = get_remote_github_events(username)

    result = {
        "status": "success",
        "username": username,
        "local": local_info or {
            "name": "End4-Enhanced-Dev",
            "branch": "main",
            "clean": True,
            "commits": []
        },
        "remote": remote_events
    }

    os.makedirs(CACHE_DIR, exist_ok=True)
    try:
        with open(CACHE_FILE, "w") as f:
            json.dump(result, f, indent=2)
    except Exception:
        pass

    print(json.dumps(result))

if __name__ == "__main__":
    main()


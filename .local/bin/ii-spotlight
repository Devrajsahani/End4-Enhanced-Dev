#!/usr/bin/env python3
# -----------------------------------------------------------------------------
# II-SPOTLIGHT: Modern Spotlight Application & Settings Launcher
# Features: Acrylic glassmorphism, Matugen dynamic theming, category sections,
#           interactive filter chips, desktop search, settings hub & math eval.
# -----------------------------------------------------------------------------
import os
import sys
import json
import math
import subprocess
import signal

# Process toggle check
PID_FILE = "/tmp/ii-spotlight.pid"
if os.path.isfile(PID_FILE):
    try:
        with open(PID_FILE, "r") as f:
            old_pid = int(f.read().strip())
        os.kill(old_pid, signal.SIGTERM)
        os.remove(PID_FILE)
        sys.exit(0)
    except Exception:
        pass

with open(PID_FILE, "w") as f:
    f.write(str(os.getpid()))

import gi
gi.require_version('Gtk', '3.0')
gi.require_version('Gdk', '3.0')
from gi.repository import Gtk, Gdk, GLib, Gio, Pango, GdkPixbuf

# Load Matugen colors with graceful defaults
def load_matugen_colors():
    defaults = {
        "surface": "#1c110c",
        "on_surface": "#fce7ec",
        "on_surface_variant": "#dfc0b4",
        "primary": "#f2a8c5",
        "on_primary": "#2b111a",
        "primary_container": "#3e2029",
        "on_primary_container": "#ffd8e2",
        "outline": "#a78b80"
    }
    path = os.path.expanduser("~/.local/state/quickshell/user/generated/colors.json")
    if os.path.isfile(path):
        try:
            with open(path, "r") as f:
                data = json.load(f)
                for k in defaults:
                    if k in data:
                        defaults[k] = data[k]
        except Exception:
            pass
    return defaults

COLORS = load_matugen_colors()

def hex_to_rgba(hex_code, alpha):
    h = hex_code.lstrip('#')
    if len(h) == 6:
        r, g, b = tuple(int(h[i:i+2], 16) for i in (0, 2, 4))
        return f"rgba({r}, {g}, {b}, {alpha})"
    return f"rgba(28, 17, 22, {alpha})"

CARD_BG = hex_to_rgba(COLORS["surface"], 0.88)
SEARCH_BG = hex_to_rgba(COLORS["surface"], 0.70)
BORDER_COLOR = hex_to_rgba(COLORS["primary"], 0.30)
ACCENT = COLORS["primary"]
TEXT_PRIMARY = COLORS["on_surface"]
TEXT_SECONDARY = hex_to_rgba(COLORS["on_surface"], 0.60)
SELECTED_BG = hex_to_rgba(COLORS["primary_container"], 0.80)
SELECTED_BORDER = hex_to_rgba(COLORS["primary"], 0.50)


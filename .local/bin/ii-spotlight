    def load_recent_files(self):
        rm = Gtk.RecentManager.get_default()
        items = []
        for item in rm.get_items():
            if not item.exists():
                continue
            uri = item.get_uri()
            if not uri.startswith("file://"):
                continue
            path = uri[7:]
            filename = os.path.basename(path)
            items.append({
                "type": "file",
                "title": filename,
                "desc": path,
                "badge": "File",
                "icon_name": "text-x-generic",
                "action": lambda p=path: subprocess.Popen(["xdg-open", p])
            })
        return items

    def on_search_changed(self, entry):
        text = entry.get_text()
        self.clear_btn.set_visible(len(text) > 0)
        self.update_search(text)

    def update_search(self, query):
        q = query.strip().lower()
        self.filtered_items = []

        # 1. Math / Calculator check
        math_res = None
        if q and (q.startswith("=") or any(op in q for op in ["+", "-", "*", "/", "^"])):
            expr = q.lstrip("=").strip()
            try:
                allowed_names = {"math": math, "sqrt": math.sqrt, "sin": math.sin, "cos": math.cos, "pi": math.pi}
                val = eval(expr, {"__builtins__": {}}, allowed_names)
                math_res = {
                    "type": "plugin",
                    "title": f"= {val}",
                    "desc": f"Calculation: {expr} (Press Enter to copy)",
                    "badge": "Calculator",
                    "icon_name": "accessories-calculator",
                    "action": lambda v=str(val): subprocess.Popen(["wl-copy", v])
                }
            except Exception:
                pass

        # 2. Filter Apps
        matched_apps = []
        if self.active_category in ["all", "apps"]:
            for a in self.apps:
                if not q or q in a["title"].lower() or q in a["desc"].lower():
                    matched_apps.append(a)

        # 3. Filter Settings
        matched_settings = []
        if self.active_category in ["all", "plugins"]:
            for s in self.settings:
                if not q or q in s["title"].lower() or q in s["desc"].lower():
                    matched_settings.append(s)

        # 4. Filter Files
        matched_files = []
        if self.active_category in ["all", "files"]:
            for f in self.recent_files:
                if not q or q in f["title"].lower() or q in f["desc"].lower():
                    matched_files.append(f)

        # 5. Web Search fallback
        web_item = None
        if q and not q.startswith("="):
            web_item = {
                "type": "plugin",
                "title": f"Search Google for \"{query.strip()}\"",
                "desc": "Open query in default web browser",
                "badge": "Web Search",
                "icon_name": "web-browser",
                "action": lambda qu=query.strip(): subprocess.Popen(["xdg-open", f"https://www.google.com/search?q={qu}"])
            }

        # Structure sections
        sections = []
        if math_res:
            sections.append(("Calculator", [math_res]))

        if matched_apps:
            sections.append(("Applications", matched_apps[:6]))

        if matched_settings:
            sections.append(("Settings", matched_settings[:6]))

        if matched_files:
            sections.append(("Files", matched_files[:5]))

        if web_item:
            sections.append(("Web Search", [web_item]))

        self.render_sections(sections)

    def render_sections(self, sections):
        # Clear previous widgets
        for child in self.results_box.get_children():
            self.results_box.remove(child)

        self.filtered_items = []
        self.rendered_widgets = []
        item_counter = 0

        for section_title, items in sections:
            # Section Header
            hdr = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
            hdr.get_style_context().add_class("section-header")

            lbl_title = Gtk.Label(label=f"::: {section_title}" if section_title == "Applications" else f"⚙ {section_title}")
            lbl_title.get_style_context().add_class("section-label")
            hdr.pack_start(lbl_title, False, False, 0)

            lbl_count = Gtk.Label(label=str(len(items)))
            lbl_count.get_style_context().add_class("section-count")
            hdr.pack_start(lbl_count, False, False, 0)

            # View controls icons (matching reference image)
            view_icons = Gtk.Label(label="▤  ☷  ▦  ⌃")
            view_icons.get_style_context().add_class("section-view-icons")
            view_icons.set_halign(Gtk.Align.END)
            hdr.pack_end(view_icons, False, False, 0)

            self.results_box.pack_start(hdr, False, False, 0)

            # Section items
            for item in items:
                row = self.create_result_row(item, item_counter)
                self.results_box.pack_start(row, False, False, 0)
                self.filtered_items.append(item)
                self.rendered_widgets.append(row)
                item_counter += 1

        self.results_box.show_all()

        # Clamp and highlight selected index
        if self.filtered_items:
            self.selected_index = max(0, min(self.selected_index, len(self.filtered_items) - 1))
            self.highlight_selected()
        else:
            self.selected_index = 0

    def create_result_row(self, item, index):
        event_box = Gtk.EventBox()
        event_box.set_visible_window(False)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        row.get_style_context().add_class("result-row")

        # Icon
        icon_img = Gtk.Image()
        if "icon" in item and item["icon"]:
            icon_img.set_from_gicon(item["icon"], Gtk.IconSize.LARGE_TOOLBAR)
        elif "icon_name" in item and item["icon_name"]:
            icon_img.set_from_icon_name(item["icon_name"], Gtk.IconSize.LARGE_TOOLBAR)
        else:
            icon_img.set_from_icon_name("application-x-executable", Gtk.IconSize.LARGE_TOOLBAR)
        icon_img.set_pixel_size(24)
        row.pack_start(icon_img, False, False, 0)

        # Title and Description
        text_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        title_lbl = Gtk.Label(label=item["title"])
        title_lbl.set_halign(Gtk.Align.START)
        title_lbl.set_ellipsize(Pango.EllipsizeMode.END)
        title_lbl.get_style_context().add_class("result-title")
        text_box.pack_start(title_lbl, False, False, 0)

        desc_lbl = Gtk.Label(label=item.get("desc", ""))
        desc_lbl.set_halign(Gtk.Align.START)
        desc_lbl.set_ellipsize(Pango.EllipsizeMode.END)
        desc_lbl.get_style_context().add_class("result-desc")
        text_box.pack_start(desc_lbl, False, False, 0)

        row.pack_start(text_box, True, True, 0)

        # Right-side badge chip
        if "badge" in item and item["badge"]:
            badge_lbl = Gtk.Label(label=item["badge"])
            badge_lbl.get_style_context().add_class("result-badge")
            badge_lbl.set_valign(Gtk.Align.CENTER)
            row.pack_end(badge_lbl, False, False, 0)

        event_box.add(row)
        event_box.connect("button-press-event", lambda w, e, idx=index: self.on_item_clicked(idx))
        event_box.row_box = row
        return event_box

    def highlight_selected(self):
        for idx, eb in enumerate(self.rendered_widgets):
            ctx = eb.row_box.get_style_context()
            if idx == self.selected_index:
                ctx.add_class("selected")
                # Scroll into view
                adj = self.scrolled.get_vadjustment()
                alloc = eb.get_allocation()
                if alloc.y < adj.get_value():
                    adj.set_value(alloc.y)
                elif alloc.y + alloc.height > adj.get_value() + adj.get_page_size():
                    adj.set_value(alloc.y + alloc.height - adj.get_page_size())
            else:
                ctx.remove_class("selected")

    def on_item_clicked(self, index):
        self.selected_index = index
        self.highlight_selected()
        self.activate_selected()

    def activate_selected(self):
        if 0 <= self.selected_index < len(self.filtered_items):
            item = self.filtered_items[self.selected_index]
            self.close_launcher()
            if "action" in item and callable(item["action"]):
                try:
                    item["action"]()
                except Exception as e:
                    print(f"Error launching item: {e}", file=sys.stderr)

    def on_key_press(self, widget, event):
        keyval = event.keyval

        if keyval == Gdk.KEY_Escape:
            self.close_launcher()
            return True

        elif keyval in [Gdk.KEY_Down, Gdk.KEY_Tab] and (event.state & Gdk.ModifierType.CONTROL_MASK):
            # Cycle filter categories with Ctrl+Tab or Ctrl+Down
            cats = ["all", "apps", "files", "plugins"]
            cur_idx = cats.index(self.active_category)
            next_cat = cats[(cur_idx + 1) % len(cats)]
            self.set_category(next_cat)
            return True

        elif keyval == Gdk.KEY_Down:
            if self.filtered_items:
                self.selected_index = (self.selected_index + 1) % len(self.filtered_items)
                self.highlight_selected()
            return True

        elif keyval == Gdk.KEY_Up:
            if self.filtered_items:
                self.selected_index = (self.selected_index - 1 + len(self.filtered_items)) % len(self.filtered_items)
                self.highlight_selected()
            return True

        elif keyval == Gdk.KEY_Return or keyval == Gdk.KEY_KP_Enter:
            self.activate_selected()
            return True

        elif keyval == Gdk.KEY_Tab:
            # Tab cycles chips
            cats = ["all", "apps", "files", "plugins"]
            cur_idx = cats.index(self.active_category)
            next_cat = cats[(cur_idx + 1) % len(cats)]
            self.set_category(next_cat)
            return True

        return False

    def on_focus_out(self, widget, event):
        self.close_launcher()
        return False

    def close_launcher(self):
        self.destroy()

    def on_destroy(self, widget):
        if os.path.isfile(PID_FILE):
            try:
                os.remove(PID_FILE)
            except Exception:
                pass
        Gtk.main_quit()

def main():
    # Disarm quickshell release trigger so super/alt space never clashes with quickshell
    try:
        subprocess.run(["qs", "-c", "ii", "ipc", "call", "search", "toggleReleaseInterrupt"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["qs", "-c", "ii", "ipc", "call", "search", "close"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

    app = SpotlightLauncher()
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()

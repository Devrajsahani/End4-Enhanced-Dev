class SpotlightLauncher(Gtk.Window):
    def __init__(self):
        GLib.set_prgname("spotlight-launcher")
        GLib.set_application_name("spotlight-launcher")
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.set_title("spotlight-launcher")
        self.set_default_size(680, 560)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_decorated(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.set_keep_above(True)

        # Transparency support
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual and screen.is_composited():
            self.set_visual(visual)
        self.set_app_paintable(True)

        self.active_category = "all"  # "all", "apps", "files", "plugins"
        self.selected_index = 0
        self.filtered_items = []
        self.rendered_widgets = []

        # Load Applications & Settings
        self.apps = self.load_applications()
        self.settings = self.load_settings()
        self.recent_files = self.load_recent_files()

        self.setup_ui()
        self.setup_css()

        # Connect event handlers
        self.connect("key-press-event", self.on_key_press)
        self.connect("focus-out-event", self.on_focus_out)
        self.connect("destroy", self.on_destroy)

        initial_q = sys.argv[1] if len(sys.argv) > 1 else ""
        if initial_q:
            self.entry.set_text(initial_q)
            self.entry.set_position(-1)
        self.update_search(initial_q)

    def setup_ui(self):
        root_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root_box.set_name("spotlight-card")
        self.add(root_box)

        # 1. Search Bar Pill
        search_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        search_box.set_name("search-bar-box")
        search_box.set_valign(Gtk.Align.CENTER)

        search_icon = Gtk.Label(label="🔍")
        search_icon.set_name("search-icon")
        search_box.pack_start(search_icon, False, False, 0)

        self.entry = Gtk.Entry()
        self.entry.set_name("search-entry")
        self.entry.set_placeholder_text("Search apps, settings, files, math, web...")
        self.entry.connect("changed", self.on_search_changed)
        search_box.pack_start(self.entry, True, True, 0)

        self.clear_btn = Gtk.Button(label="✕")
        self.clear_btn.set_name("clear-btn")
        self.clear_btn.connect("clicked", lambda b: self.entry.set_text(""))
        self.clear_btn.set_visible(False)
        search_box.pack_start(self.clear_btn, False, False, 0)

        root_box.pack_start(search_box, False, False, 0)

        # 2. Results Container (Scrollable)
        self.scrolled = Gtk.ScrolledWindow()
        self.scrolled.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.scrolled.set_propagate_natural_height(True)
        self.scrolled.set_min_content_height(420)
        self.scrolled.set_max_content_height(420)

        self.results_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self.scrolled.add(self.results_box)
        root_box.pack_start(self.scrolled, True, True, 0)

        # 3. Bottom Filter Chips & Hints Footer
        footer_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        footer_box.set_name("footer-box")

        self.chips = {}
        chip_defs = [
            ("all", "🔍 All"),
            ("apps", "󰀻 Apps"),
            ("files", "📁 Files"),
            ("plugins", "⚙ Plugins")
        ]

        for cat_id, label in chip_defs:
            btn = Gtk.Button(label=label)
            btn.get_style_context().add_class("filter-chip")
            if cat_id == self.active_category:
                btn.get_style_context().add_class("active")
            btn.connect("clicked", lambda b, c=cat_id: self.set_category(c))
            footer_box.pack_start(btn, False, False, 0)
            self.chips[cat_id] = btn

        # Right-side navigation hints
        hints_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        hints_box.set_halign(Gtk.Align.END)
        hints = ["↑↓ nav", "↵ open", "Tab filter", "Esc close"]
        for h in hints:
            lbl = Gtk.Label(label=h)
            lbl.get_style_context().add_class("nav-hint")
            hints_box.pack_start(lbl, False, False, 0)

        footer_box.pack_end(hints_box, False, False, 0)
        root_box.pack_start(footer_box, False, False, 0)

    def setup_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS_STYLES.encode('utf-8'))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

    def set_category(self, cat_id):
        self.active_category = cat_id
        for cid, btn in self.chips.items():
            ctx = btn.get_style_context()
            if cid == cat_id:
                ctx.add_class("active")
            else:
                ctx.remove_class("active")
        self.update_search(self.entry.get_text())

    def load_applications(self):
        apps = []
        seen = set()
        for app in Gio.AppInfo.get_all():
            if not app.should_show():
                continue
            name = app.get_display_name() or ""
            desc = app.get_description() or ""
            exec_cmd = app.get_executable() or ""
            key = (name.lower(), exec_cmd)
            if key in seen:
                continue
            seen.add(key)

            icon = app.get_icon()
            apps.append({
                "type": "app",
                "title": name,
                "desc": desc if desc else exec_cmd,
                "badge": "App",
                "icon": icon,
                "action": lambda a=app: a.launch()
            })
        apps.sort(key=lambda x: x["title"].lower())
        return apps


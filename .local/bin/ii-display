#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# II-DISPLAY: Modern Display Profile Switcher for Hyprland
# Features: Card deck UI, active badge, hardware detection, zero search conflict
# -----------------------------------------------------------------------------
set -euo pipefail

# 1. Disarm Quickshell search release trigger immediately to prevent overview/search popup
if command -v qs >/dev/null 2>&1; then
    qs -c ii ipc call search toggleReleaseInterrupt 2>/dev/null || true
    qs -c ii ipc call search close 2>/dev/null || true
fi

THEME_DIR="$HOME/.config/illogical-impulse/theme-packs"
ROFI_THEME="$THEME_DIR/display.rasi"
PROFILE_FILE="$HOME/.config/hypr/display-profile"

# Read current profile
current_profile="laptop-only"
if [[ -f "$PROFILE_FILE" ]]; then
    current_profile=$(tr -d '[:space:]' < "$PROFILE_FILE")
fi

# Detect external HDMI connection
external_connected=false
for f in /sys/class/drm/card*-HDMI-A-1/status; do
    if [[ -r "$f" ]] && grep -qi "connected" "$f"; then
        external_connected=true
        break
    fi
done

# Active badges
laptop_badge=""
extend_badge=""
external_badge=""
selected_row=0

if [[ "$current_profile" == "laptop-only" ]]; then
    laptop_badge=" <span foreground='#b2d189' weight='bold'>[ACTIVE ✔]</span>"
    selected_row=0
elif [[ "$current_profile" == "extend" ]]; then
    extend_badge=" <span foreground='#b2d189' weight='bold'>[ACTIVE ✔]</span>"
    selected_row=1
elif [[ "$current_profile" == "external-only" ]]; then
    external_badge=" <span foreground='#b2d189' weight='bold'>[ACTIVE ✔]</span>"
    selected_row=2
fi

hdmi_status=""
if ! $external_connected; then
    hdmi_status=" <span foreground='#e57373'>[HDMI Unplugged]</span>"
fi

# Card definitions (Pango markup for Rofi)
card_laptop="<b>󰌢  Laptop Screen Only</b>   <span alpha='65%'>│</span>   <span size='smaller' alpha='80%'>Internal eDP-1 (1080p@60Hz) • External screen off</span>${laptop_badge}"
card_extend="<b>󰍹  Extend Displays (Dual)</b>   <span alpha='65%'>│</span>   <span size='smaller' alpha='80%'>Dual side-by-side • eDP-1 + HDMI-A-1</span>${extend_badge}${hdmi_status}"
card_external="<b>󰍹  External Monitor Only</b>   <span alpha='65%'>│</span>   <span size='smaller' alpha='80%'>Acer 120Hz (HDMI-A-1) • Laptop screen off</span>${external_badge}${hdmi_status}"

items=("$card_laptop" "$card_extend" "$card_external")

choice=$(printf '%s\n' "${items[@]}" | rofi \
    -dmenu \
    -i \
    -markup-rows \
    -selected-row "$selected_row" \
    -theme "$ROFI_THEME" \
    -p "󰍹 Display Mode") || exit 0

[[ -z "$choice" ]] && exit 0

# Determine selected target
new_profile=""
display_name=""

case "$choice" in
    *"Laptop Only"*)
        new_profile="laptop-only"
        display_name="Laptop Screen Only (eDP-1)"
        ;;
    *"Extend Displays"*)
        new_profile="extend"
        display_name="Extended Dual Displays (eDP-1 + HDMI)"
        ;;
    *"External Only"*)
        new_profile="external-only"
        display_name="External Monitor Only (HDMI-A-1)"
        ;;
    *)
        exit 0
        ;;
esac

# Disarm search again after rofi exits
if command -v qs >/dev/null 2>&1; then
    qs -c ii ipc call search toggleReleaseInterrupt 2>/dev/null || true
    qs -c ii ipc call search close 2>/dev/null || true
fi

# Save and apply profile
previous="$current_profile"
printf '%s\n' "$new_profile" > "$PROFILE_FILE"

if ! hyprctl eval 'applyDisplayProfile()' >/dev/null 2>&1; then
    printf '%s\n' "$previous" > "$PROFILE_FILE"
    notify-send -a 'Display Switcher' -i 'dialog-error' 'Display Profile Failed' 'Failed to apply profile. Restored previous configuration.'
    exit 1
fi

notify-send -a 'Display Switcher' -i 'video-display' 'Display Profile Applied' "$display_name"
